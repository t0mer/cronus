# Dockerfile used by goreleaser's docker pipeline. The binary is pre-built and
# cross-compiled by goreleaser and copied into the build context as "cronus";
# this file only assembles the minimal scratch runtime around it.
FROM alpine:3.20 AS certs
RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /data && chown 65534:65534 /data

FROM scratch
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=certs /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=certs --chown=65534:65534 /data /data
COPY cronus /cronus

ENV CRONUS_DB_PATH=/data/cronus.db
EXPOSE 8080
VOLUME ["/data"]
USER 65534:65534

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/cronus", "healthcheck"]

ENTRYPOINT ["/cronus"]
